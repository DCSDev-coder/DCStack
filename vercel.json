{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://portal.dcstack.my/api/:path*"
    },
    {
      "source": "/rack-console/:path*",
      "destination": "https://portal.dcstack.my/rack-console/:path*"
    },
    { "source": "/support", "destination": "/index.html" },
    { "source": "/smart-rack", "destination": "/index.html" },
    { "source": "/smart-rack/:path*", "destination": "/index.html" }
  ]
}
